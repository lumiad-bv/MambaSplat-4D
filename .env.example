# Copy to .env and export (set -a; . ./.env; set +a) before running any entry
# point. CLI overrides win: paths.data_root=/mnt/data/aerosplat

# Parent of preprocessed_50-25-25_4class (default: ./dataset)
AEROSPLAT_DATA_ROOT=/path/to/dataset
# Where runs write checkpoints, logs and eval JSON (default: ./results)
AEROSPLAT_RESULTS_ROOT=/path/to/results
# SO(3) rotation caches read by eval_rotation (default: ./dataset/rotation_cache)
AEROSPLAT_ROTATIONS_DIR=/path/to/dataset/rotation_cache

WANDB_MODE=disabled

# Dataset generation only (pipelines/isaacsim): your own animated assets and render
# output dir. Assets not redistributed.
AEROSPLAT_ASSET_ROOT=/path/to/assets
AEROSPLAT_RENDER_ROOT=/path/to/renders
ISAAC_SIM_PATH=/path/to/isaacsim
